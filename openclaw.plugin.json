{
  "id": "singleintent",
  "name": "SingleIntent",
  "description": "SingleIntent MCP server for OpenClaw.",
  "version": "0.1.3",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "mcpServers": {
    "singleintent": {
      "transport": "stdio",
      "command": "node",
      "args": ["./dist/mcp-server.js"],
      "env": {
        "SINGLEINTENT_CONFIG": "${CLAUDE_PLUGIN_ROOT}/instance.json"
      }
    }
  }
}
